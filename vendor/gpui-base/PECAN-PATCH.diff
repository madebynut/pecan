+/// Parse only emphasis within an opted-in code capsule. Preserve one native
+/// run and compose source mappings so selection/search still address the original fence.
+fn emphasized_code(
+    source: &str,
+    code: &str,
+    span: Option<Span>,
+    cx: &NodeContext,
+) -> Option<InlineNode> {
+    if !cx.markdown_extensions.parses_inline_code_emphasis() || !code.contains(['*', '_', '~']) {
+        return None;
+    }
+    fn allowed(node: &Node, has_emphasis: &mut bool) -> bool {
+        match node {
+            Node::Text(_) | Node::Break(_) => true,
+            Node::Strong(_) | Node::Emphasis(_) | Node::Delete(_) => {
+                *has_emphasis = true;
+                node.children().is_some_and(|children| {
+                    children.iter().all(|child| allowed(child, has_emphasis))
+                })
+            }
+            _ => false,
+        }
+    }
+    let core = code.trim_matches(' ');
+    let leading = code.len() - code.trim_start_matches(' ').len();
+    let trailing = code.len() - code.trim_end_matches(' ').len();
+    let mut options = ParseOptions::default();
+    options.constructs.gfm_strikethrough = true;
+    let Node::Root(root) = markdown::to_mdast(core, &options).ok()? else {
+        return None;
+    };
+    let [Node::Paragraph(parsed)] = root.children.as_slice() else {
+        return None;
+    };
+    let mut has_emphasis = false;
+    if !parsed
+        .children
+        .iter()
+        .all(|child| allowed(child, &mut has_emphasis))
+        || !has_emphasis
+    {
+        return None;
+    }
+    let mut paragraph = Paragraph::default();
+    merge_children_with_mark(
+        core,
+        &mut paragraph,
+        &parsed.children,
+        TextMark::default().code(),
+        &mut NodeContext::default(),
+    );
+    let mut inline = paragraph.children.pop()?;
+    let mapping = code_source_segments(source, code, span, cx.offset);
+    let body_len = inline.text.len();
+    let mut segments = Vec::with_capacity(inline.source_segments.len() + 2);
+    if leading > 0 {
+        segments.push(SourceSegment {
+            rendered: 0..leading,
+            source: node::source_range_for_segments(&mapping, 0..leading)?,
+            linear: true,
+        });
+    }
+    for segment in inline.source_segments {
+        let rendered = segment.rendered.start + leading..segment.rendered.end + leading;
+        let source = node::source_range_for_segments(
+            &mapping,
+            segment.source.start + leading..segment.source.end + leading,
+        )?;
+        segments.push(SourceSegment {
+            linear: segment.linear && rendered.len() == source.len(),
+            rendered,
+            source,
+        });
+    }
+    if trailing > 0 {
+        segments.push(SourceSegment {
+            rendered: leading + body_len..leading + body_len + trailing,
+            source: node::source_range_for_segments(&mapping, code.len() - trailing..code.len())?,
+            linear: true,
+        });
+    }
+    for (range, _) in &mut inline.marks {
+        range.start += leading;
+        range.end += leading;
+    }
+    inline.text = format!(
+        "{}{}{}",
+        &code[..leading],
+        inline.text,
+        &code[code.len() - trailing..]
+    )
+    .into();
+    if let Some((range, _)) = inline.marks.last_mut() {
+        *range = 0..inline.text.len();
+    }
+    inline.source_segments = segments;
+    Some(inline)
+}
