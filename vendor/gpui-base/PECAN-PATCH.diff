+    fn inline_code_emphasis_is_opt_in_and_preserves_literal_blocks() {
+        for literal in [
+            "snake_case",
+            r"snake\_case",
+            "snake_case &amp;",
+            "# _comment_",
+            "<b>html</b> *strong*",
+            "[link](url) *strong*",
+            "`literal` *strong*",
+        ] {
+            let source = format!("`` {literal} ``");
+            let mut cx = NodeContext {
+                markdown_extensions: MarkdownExtensions::default().inline_code_emphasis().into(),
+                ..Default::default()
+            };
+            let document = parse(&source, &mut cx).expect("parse code literal");
+            assert_eq!(document.text().trim_end(), literal, "literal {source:?}");
+        }
+        let source = "`**加粗** *italic* ~~旧版~~ ***both***`";
+        let default = parse(source, &mut NodeContext::default()).expect("standard CommonMark");
+        assert!(default.text().contains("**加粗**"));
+        let mut cx = NodeContext {
+            markdown_extensions: MarkdownExtensions::default().inline_code_emphasis().into(),
+            ..Default::default()
+        };
+        let document = parse(source, &mut cx).expect("rich code");
+        let paragraph = document
+            .blocks
+            .iter()
+            .find_map(first_paragraph)
+            .expect("native paragraph");
+        assert_eq!(paragraph.text(), "加粗 italic 旧版 both");
+        assert_eq!(
+            paragraph.children.len(),
+            1,
+            "a capsule stays one native run"
+        );
+        let inline = &paragraph.children[0];
+        for (word, wanted) in [
+            ("加粗", TextMark::default().bold()),
+            ("italic", TextMark::default().italic()),
+            ("旧版", TextMark::default().strikethrough()),
+            ("both", TextMark::default().bold().italic()),
+        ] {
+            let start = inline.text.find(word).expect("styled word");
+            let mut actual = TextMark::default();
+            for (range, mark) in &inline.marks {
+                if range.start <= start && range.end >= start + word.len() {
+                    actual.merge(mark.clone());
+                }
+            }
+            assert!(actual.code);
+            assert_eq!(
+                (actual.bold, actual.italic, actual.strikethrough),
+                (wanted.bold, wanted.italic, wanted.strikethrough),
+                "style {word}"
+            );
+            let original =
+                node::source_range_for_segments(&inline.source_segments, start..start + word.len())
+                    .expect("mapped source");
+            assert_eq!(&source[original], word, "selection {word}");
+        }
+        let blocks = parse("```text\n**literal** *text* ~~code~~\n```\n\n```mermaid\nflowchart LR\nA[**literal**] --> B\n```", &mut cx).expect("fences");
+        assert!(blocks.text().contains("**literal** *text* ~~code~~"));
+        assert!(blocks.text().contains("A[**literal**]"));
+    }
