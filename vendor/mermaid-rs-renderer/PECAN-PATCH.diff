+// Badge geometry stays uniform across digit counts and light/dark typography.
+const SEQUENCE_NUMBER_MIN_RADIUS: f32 = 10.0;
+const SEQUENCE_NUMBER_FONT_SIZE: f32 = 12.0;
+
+fn sequence_number_radius(theme: &Theme) -> f32 {
+    // Reserve enough room for every two-digit value at the same size as one digit.
+    // Width metrics are additive; repeating the widest digit covers mixed pairs.
+    let width = ["00", "11", "22", "33", "44", "55", "66", "77", "88", "99"]
+        .iter()
+        .filter_map(|label| {
+            crate::text_metrics::measure_text_width(
+                label,
+                SEQUENCE_NUMBER_FONT_SIZE,
+                &theme.font_family,
+            )
+        })
+        .fold(SEQUENCE_NUMBER_FONT_SIZE * 2.0 * 0.65, f32::max);
+    // Allow for bold glyphs, with a compact inset for double-digit numbers.
+    ((width * 1.1).hypot(SEQUENCE_NUMBER_FONT_SIZE) / 2.0 + 0.25)
+        .ceil()
+        .max(SEQUENCE_NUMBER_MIN_RADIUS)
+}
+
+fn sequence_number_font_size(value: usize, theme: &Theme, radius: f32) -> f32 {
+    if value < 100 {
+        return SEQUENCE_NUMBER_FONT_SIZE;
+    }
+    let label = value.to_string();
+    let font_size = SEQUENCE_NUMBER_FONT_SIZE;
+    let width = crate::text_metrics::measure_text_width(&label, font_size, &theme.font_family)
+        .unwrap_or(label.len() as f32 * font_size * 0.65);
+    // Metrics use the regular face; reserve width for the rendered bold digits.
+    let diagonal = (width * 1.1).hypot(font_size);
+    font_size * (2.0 * (radius - 0.5) / diagonal).min(1.0)
+}
+
+fn place_sequence_center_labels(
+    edges: &mut [EdgeLayout],
+    numbers: &[SequenceNumberLayout],
+    theme: &Theme,
+) {
+    for (index, edge) in edges.iter_mut().enumerate() {
+        let start = edge.points.first().copied().unwrap_or_default();
+        let end = edge.points.last().copied().unwrap_or(start);
+        if let Some(label) = &edge.label {
+            let x = if edge.from == edge.to {
+                start.0 + theme.font_size * 0.75 + label.width / 2.0
+            } else {
+                (start.0 + end.0) / 2.0
+            };
+            let radius = numbers.get(index).map_or(0.0, |number| number.radius);
+            let gap = radius.max(theme.font_size * 0.5) + 3.0;
+            edge.label_anchor = Some((x, start.1 - gap - label.height / 2.0));
+        }
+    }
+}
