+/// A cubic stays in its control hull; only smooth monotonic routes with empty hulls.
+fn control_hull_is_clear(edge: &EdgeLayout, layout: &Layout) -> bool {
+    if !layout.subgraphs.is_empty() {
+        return false;
+    }
+    let (start, end) = (edge.points[0], edge.points[edge.points.len() - 1]);
+    let (left, right) = (start.0.min(end.0), start.0.max(end.0));
+    let (top, bottom) = (start.1.min(end.1), start.1.max(end.1));
+    edge.points.iter().all(|&(x, y)| {
+        x >= left - 0.01 && x <= right + 0.01 && y >= top - 0.01 && y <= bottom + 0.01
+    }) && !layout.nodes.values().any(|node| {
+        !node.hidden
+            && node.id != edge.from
+            && node.id != edge.to
+            && node.x < right + 8.0
+            && node.x + node.width > left - 8.0
+            && node.y < bottom + 8.0
+            && node.y + node.height > top - 8.0
+    })
 }
 
