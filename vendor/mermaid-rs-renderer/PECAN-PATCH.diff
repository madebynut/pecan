+) -> f32 {
+    let condition = label.map_or(0.0, |label| {
+        measure_sequence_text(&format!("[{label}]"), theme, config).height
+    });
+    let tag = if first {
+        (theme.font_size * 1.5).max(24.0)
+    } else {
+        0.0
+    };
+    tag + condition + theme.font_size
 }
 
