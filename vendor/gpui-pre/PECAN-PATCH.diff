+    /// Visible glyph extent of the first text row, in window coordinates.
+    /// Font metrics are resolved once per shaped layout; moving the element
+    /// only translates the cached extent. Blank rows have no ink extent.
+    pub fn first_line_ink(&self, window: &Window) -> Option<Bounds<Pixels>> {
+        let mut inner = self.0.borrow_mut();
+        let inner = inner.as_mut()?;
+        if inner.first_ink.is_none() {
+            let ink = inner.lines.first().and_then(|line| {
+                let end = line
+                    .wrap_boundaries
+                    .first()
+                    .map(|end| (end.run_ix, end.glyph_ix));
+                let mut ink: Option<(Pixels, Pixels)> = None;
+                for (run_ix, run) in line.unwrapped_layout.runs.iter().enumerate() {
+                    for (glyph_ix, glyph) in run.glyphs.iter().enumerate() {
+                        if end.is_some_and(|end| (run_ix, glyph_ix) >= end) {
+                            break;
+                        }
+                        let Ok(bounds) = window.text_system().typographic_bounds_for_glyph(
+                            run.font_id,
+                            line.font_size(),
+                            glyph.id,
+                        ) else {
+                            continue;
+                        };
+                        if bounds.size.height <= Pixels::ZERO || bounds.size.width <= Pixels::ZERO {
+                            continue;
+                        }
+                        // Font glyph coordinates are y-up; window coordinates are y-down.
+                        let top = -bounds.bottom() + glyph.position.y;
+                        let bottom = -bounds.top() + glyph.position.y;
+                        ink = Some(
+                            ink.map_or((top, bottom), |(lo, hi)| (lo.min(top), hi.max(bottom))),
+                        );
+                    }
+                }
+                let (top, bottom) = ink?;
+                let baseline =
+                    (inner.line_height - line.ascent() - line.descent()) / 2. + line.ascent();
+                Some((baseline + top, baseline + bottom))
+            });
+            inner.first_ink = Some(ink);
+        }
+        let (top, bottom) = inner.first_ink??;
+        let bounds = inner.bounds?;
+        Some(Bounds::from_corners(
+            point(bounds.left(), bounds.top() + top),
+            point(bounds.right(), bounds.top() + bottom),
+        ))
+    }
+
+    /// Byte boundaries where spacing may expand without splitting a word or a glyph cluster.
+    pub fn justification_boundaries(text: &str) -> Vec<usize> {
+        if text
+            .chars()
+            .any(|c| matches!(c as u32, 0x590..=0x8ff | 0xfb1d..=0xfdff | 0xfe70..=0xfeff))
+        {
+            return Vec::new();
+        }
+        fn cjk(c: char) -> bool {
+            matches!(c as u32, 0x3400..=0x9fff | 0x20000..=0x3134f |
+                0x3040..=0x30ff | 0xac00..=0xd7af)
+        }
+        let mut previous = None;
+        let mut has_content = false;
+        let mut boundaries = Vec::new();
+        for (index, current) in text.char_indices() {
+            if let Some(before) = previous {
+                // A fragment's leading space separates it from an inline atom;
+                // only spaces between words may absorb justification.
+                let space = has_content && before == ' ' && !current.is_whitespace();
+                let ideograph = (cjk(before) || cjk(current))
+                    && !before.is_whitespace()
+                    && !current.is_whitespace()
+                    && !"（([【《「『".contains(before)
+                    && !"，。！？：；、）)]】》」』,.!?;:".contains(current);
+                if space || ideograph {
+                    boundaries.push(index);
+                }
+            }
+            previous = Some(current);
+            has_content |= !current.is_whitespace();
+        }
+        boundaries
+    }
+
+    /// The width used to wrap the natural shaped layout.
+    pub fn wrap_width(&self) -> Option<Pixels> {
+        self.0.borrow().as_ref().and_then(|state| state.wrap_width)
+    }
+
+    /// Justifies soft-wrapped rows, preserving each hard line's final row.
+    /// Call after prepaint so selection and painting share the adjusted glyph positions.
+    pub fn justify_wrapped(&self, width: Pixels) {
+        self.set_justification(width, false);
+    }
+
+    /// Justifies one already-wrapped fragment without reshaping or changing its source indices.
+    pub fn justify_single_line(&self, width: Pixels) {
+        self.set_justification(width, true);
+    }
+
+    /// Restores the natural positions when a retained layout is used without justification.
+    pub fn clear_justification(&self) {
+        if let Some(state) = self.0.borrow_mut().as_mut() {
+            if let Some(lines) = state.natural_lines.take() {
+                state.lines = lines;
+            }
+            state.justification = None;
+        }
+    }
+
+    fn set_justification(&self, width: Pixels, include_last: bool) {
+        use crate::{LineLayout, WrappedLineLayout, px};
+        let mut state = self.0.borrow_mut();
+        let Some(state) = state.as_mut() else { return };
+        if state.justification == Some((width, include_last)) {
+            return;
+        }
+        if let Some(lines) = state.natural_lines.as_ref() {
+            state.lines = lines.clone();
+        } else {
+            state.natural_lines = Some(state.lines.clone());
+        }
+        state.justification = Some((width, include_last));
+        for line in &mut state.lines {
+            let natural = &line.layout.unwrapped_layout;
+            let glyphs = natural
+                .runs
+                .iter()
+                .flat_map(|run| &run.glyphs)
+                .collect::<Vec<_>>();
+            // Visual-order RTL runs must keep their platform layout.
+            if glyphs.windows(2).any(|pair| pair[0].index > pair[1].index) {
+                continue;
+            }
+            let mut rows = vec![0];
+            rows.extend(
+                line.wrap_boundaries
+                    .iter()
+                    .map(|boundary| natural.runs[boundary.run_ix].glyphs[boundary.glyph_ix].index),
+            );
+            rows.push(natural.len);
+            let mut expansions = Vec::new();
+            for (row_ix, row) in rows.windows(2).enumerate() {
+                if !include_last && row_ix + 2 == rows.len() {
+                    break;
+                }
+                let Some(text) = line.text.get(row[0]..row[1]) else {
+                    continue;
+                };
+                // InlineFlow has already reserved trailing whitespace in the
+                // fragment's advance. Trimming it here would expand it twice.
+                let trimmed_end = if include_last {
+                    row[1]
+                } else {
+                    row[0] + text.trim_end_matches(' ').len()
+                };
+                let row_width = natural.x_for_index(trimmed_end) - natural.x_for_index(row[0]);
+                let extra = width - row_width;
+                if extra <= px(0.5) {
+                    continue;
+                }
+                let boundaries = Self::justification_boundaries(text)
+                    .into_iter()
+                    .map(|index| index + row[0])
+                    .filter(|index| {
+                        *index < trimmed_end
+                            && glyphs
+                                .binary_search_by_key(index, |glyph| glyph.index)
+                                .is_ok()
+                    })
+                    .collect::<Vec<_>>();
+                if boundaries.is_empty() {
+                    continue;
+                }
+                let spacing = extra / boundaries.len() as f32;
+                expansions.extend(boundaries.into_iter().map(|index| (index, spacing)));
+            }
+            if expansions.is_empty() {
+                continue;
+            }
+            let mut runs = natural.runs.clone();
+            let mut expansion_ix = 0;
+            let mut offset = Pixels::ZERO;
+            for glyph in runs.iter_mut().flat_map(|run| &mut run.glyphs) {
+                while expansion_ix < expansions.len() && expansions[expansion_ix].0 <= glyph.index {
+                    offset += expansions[expansion_ix].1;
+                    expansion_ix += 1;
+                }
+                glyph.position.x += offset;
+            }
+            let layout = LineLayout {
+                font_size: natural.font_size,
+                width: natural.width + offset,
+                ascent: natural.ascent,
+                descent: natural.descent,
+                runs,
+                len: natural.len,
+            };
+            line.layout = Arc::new(WrappedLineLayout {
+                unwrapped_layout: Arc::new(layout),
+                wrap_boundaries: line.wrap_boundaries.clone(),
+                wrap_width: line.wrap_width,
+            });
+        }
+        if let Some(bounds) = &mut state.bounds {
+            bounds.size.width = bounds.size.width.max(width);
+        }
     }
 
